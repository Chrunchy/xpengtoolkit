# Copy to .env and fill in; `docker compose` reads it automatically.
# Never commit the filled-in file - it holds account credentials.

# Any long random string. The same value is passed to both companions.
SOLVER_TOKEN=change-me

# The dedicated XPENG account this instance renews. Never the phone-app account:
# XPENG keeps one active session per account.
XPENG_EMAIL=dedicated-account@example.com
XPENG_PASSWORD=that-accounts-password

# Bearer token for the renewal app's POST /renew (any long random string).
RENEW_TOKEN=a-second-secret

# A Home Assistant long-lived access token from an admin profile.
HA_TOKEN=

# Where the renewal app reaches the Home Assistant Core API.
CORE_API=http://homeassistant:8123/api

# Host directories. The secrets directory must be mounted into the Home Assistant
# container at the same absolute path (/config/xpeng-secrets); the certificates
# directory holds ca-chain.crt, client-cert-0.pem and client-key.pem.
XPENG_SECRETS_DIR=./xpeng-secrets
XPENG_CERTS_DIR=./xpeng-certs

# Optional.
COMMAND_MODE=safe_plus
RENEW_PORT=8090
